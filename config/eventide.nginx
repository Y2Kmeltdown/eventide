# ──────────────────────────────────────────────────────────────────────────────
# Eventide Backend nginx config  (deploy to /etc/nginx/sites-enabled/eventide-backend)
#
# This server lives on the DATA-CONSTRAINED link device.
# It handles ONLY:
#   - Playback streams          (/playback/ → 127.0.0.1:8084, base component)
#   - Flask API + module proxy  (eventide.py @ 127.0.0.1:5000)
#
# Module network locations (MJPEG streams, per-module HTTP APIs, the gimbal
# API) are NOT hardcoded here.  eventide.py allocates each module socket a
# TCP port at install time and proxies any module HTTP service generically at
#
#   /proxy/<module>/<socket>/<upstream path>  →  127.0.0.1:<port>/<upstream path>
#
# resolved from the installed-modules registry (see docs/MODULES.md).  Modules
# can be installed and removed without ever touching this file.
#
# The dashboard HTML and map tiles are normally served by the separate
# frontend server (see eventide-frontend.nginx.conf) to keep that bandwidth
# off the data-constrained link.  eventide.py CAN also serve them itself
# (it handles GET / and /tiles/), in which case this vhost's "location /"
# fallthrough makes the full UI available directly from this device — useful
# for local/field access where link bandwidth is not a concern.
#
# CORS headers are added by eventide.py itself so the browser can call
# this server cross-origin from wherever the frontend is hosted.
# ──────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    server_name _;  # matches any hostname / IP

    # --- MJPEG playback (eventide-core default module) ---
    # The playback server is provided by the built-in eventide-core module,
    # which declares a TCP socket named 'playback' on port 8084. nginx proxies
    # the /playback/ path directly to that port. When nginx is absent, eventide.py
    # proxies /playback/ to the module's socket as well, so both deployments behave
    # identically.
    location /playback/ {
        proxy_pass http://127.0.0.1:8084/;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        chunked_transfer_encoding on;
    }

    # --- Supervisord XML-RPC ---
    # NOTE: /supervisor/ is not proxied here directly.
    # eventide.py handles it in Flask (/supervisor/ → POST → supervisord
    # at 127.0.0.1:9001/RPC2).  This is because the dashboard is cross-origin;
    # the browser sends a CORS preflight (OPTIONS) first, which supervisord's
    # own HTTP server rejects with 501.  Flask answers OPTIONS cleanly and
    # forwards only the POST server-side, so supervisord never sees the
    # cross-origin request.

    # --- Flask API (eventide.py) ---
    # Covers /api/*, /proxy/<module>/<socket>/* (module streams & APIs),
    # /supervisor/, and the standalone dashboard/tiles fallthrough.
    location / {
        proxy_pass http://127.0.0.1:5000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # MJPEG streams flow through /proxy/… — don't buffer them.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # NOTE: /tiles/ is intentionally NOT a dedicated location here.
    # Map tiles are normally proxied by the frontend server, keeping tile
    # bandwidth off the data-constrained link entirely.  When the UI is
    # served by eventide.py directly (standalone/local access), /tiles/
    # falls through to eventide.py's own tile proxy via "location /".
}
