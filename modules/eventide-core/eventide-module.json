{
  "name": "eventide-core",
  "version": "1.0.0",
  "description": "Core Eventide services: playback server, master recording control, and scheduled (cron) recording.",
  "author": "Eventide",
  "install": {
    "commands": ["cd playback && cargo build --release"],
    "artifacts": {
      "playback/target/release/playback": "{install_dir}/playback"
    }
  },
  "programs": [
    {
      "name": "playback_server",
      "command": "{install_dir}/playback --recordings {recordings_dir} --bind 0.0.0.0:{socket:playback}",
      "directory": "{install_dir}",
      "autostart": true,
      "autorestart": true,
      "startretries": 10000,
      "priority": 2,
      "user": "root",
      "arguments": [],
      "sockets": [
        { "name": "playback", "direction": "output", "transport": "http",
          "pattern": "request-reply", "port": 8084,
          "description": "MJPEG playback server" }
      ]
    },
    {
      "name": "recording_scheduler",
      "command": "{venv_python} {module_dir}/scheduler.py --port {socket:scheduler_api} --data-file {module_dir}/data/schedules.json --backend-url {arg:backend_url}",
      "directory": "{module_dir}",
      "autostart": true,
      "autorestart": true,
      "startretries": 10000,
      "priority": 3,
      "user": "root",
      "arguments": [
        {
          "name": "backend_url",
          "flag": "--backend-url",
          "type": "str",
          "default": "http://127.0.0.1:5000",
          "required": false,
          "description": "Base URL of the eventide backend (eventide.py), used by the scheduler to call /api/recording/trigger when a schedule fires."
        }
      ],
      "sockets": [
        { "name": "scheduler_api", "direction": "output", "transport": "http",
          "pattern": "request-reply",
          "description": "Scheduled-recording CRUD API (GET/POST /api/schedules, PATCH/DELETE /api/schedules/<id>). Port allocated by eventide at graph-submit time." }
      ],
      "ui": [
        { "id": "master-record", "type": "master-record", "title": "RECORDING", "region": "sidebar", "default": true },
        {
          "id": "schedule-form",
          "type": "form",
          "title": "SCHEDULE RECORDING",
          "region": "sidebar",
          "default": true,
          "socket": "scheduler_api",
          "put": "/api/schedules",
          "method": "POST",
          "submit_label": "+ ADD SCHEDULE",
          "fields": [
            {"key": "label", "label": "Label", "kind": "text"},
            {"key": "cron", "label": "Cron (m h dom mon dow)", "kind": "text"},
            {"key": "duration_seconds", "label": "Duration (s, 0 = until stopped)", "kind": "number", "min": 0}
          ]
        },
        {
          "id": "schedule-table",
          "type": "schedule-table",
          "title": "SCHEDULED RECORDINGS",
          "region": "sidebar",
          "default": true,
          "socket": "scheduler_api",
          "get": "/api/schedules",
          "interval": 5000
        }
      ]
    },
    {
      "name": "stream_fanout_irregular",
      "command": "{venv_python} {module_dir}/stream_fanout.py --in {socket:in} --out {socket:out}",
      "directory": "{module_dir}",
      "autostart": true,
      "autorestart": true,
      "startretries": 10000,
      "priority": 10,
      "user": "root",
      "arguments": [
        { "name": "fanout_count", "flag": "--fanout-count", "type": "int", "default": 2,
          "required": false, "description": "Number of duplicate outputs to produce." }
      ],
      "sockets": [
        { "name": "in", "direction": "input", "transport": "unix", "pattern": "stream",
          "stream_kind": "irregular",
          "description": "Upstream unframed, variable-size stream to duplicate." },
        { "name": "out", "direction": "output", "transport": "unix", "pattern": "stream",
          "stream_kind": "irregular", "capped": true, "count_arg": "fanout_count",
          "description": "One duplicate output per connected consumer, up to fanout_count — see docs/GRAPH_SUPERVISOR_PLAN.md §9." }
      ]
    },
    {
      "name": "stream_fanout_regular",
      "command": "{venv_python} {module_dir}/stream_fanout.py --in {socket:in} --out {socket:out}",
      "directory": "{module_dir}",
      "autostart": true,
      "autorestart": true,
      "startretries": 10000,
      "priority": 10,
      "user": "root",
      "arguments": [
        { "name": "fanout_count", "flag": "--fanout-count", "type": "int", "default": 2,
          "required": false, "description": "Number of duplicate outputs to produce." }
      ],
      "sockets": [
        { "name": "in", "direction": "input", "transport": "unix", "pattern": "stream",
          "stream_kind": "regular",
          "description": "Upstream unframed, fixed-size stream to duplicate." },
        { "name": "out", "direction": "output", "transport": "unix", "pattern": "stream",
          "stream_kind": "regular", "capped": true, "count_arg": "fanout_count",
          "description": "One duplicate output per connected consumer, up to fanout_count — see docs/GRAPH_SUPERVISOR_PLAN.md §9." }
      ]
    },
    {
      "name": "stream_fanout_framed",
      "command": "{venv_python} {module_dir}/stream_fanout.py --in {socket:in} --out {socket:out}",
      "directory": "{module_dir}",
      "autostart": true,
      "autorestart": true,
      "startretries": 10000,
      "priority": 10,
      "user": "root",
      "arguments": [
        { "name": "fanout_count", "flag": "--fanout-count", "type": "int", "default": 2,
          "required": false, "description": "Number of duplicate outputs to produce." }
      ],
      "sockets": [
        { "name": "in", "direction": "input", "transport": "unix", "pattern": "stream",
          "stream_kind": "framed",
          "description": "Upstream length-prefixed stream to duplicate." },
        { "name": "out", "direction": "output", "transport": "unix", "pattern": "stream",
          "stream_kind": "framed", "capped": true, "count_arg": "fanout_count",
          "description": "One duplicate output per connected consumer, up to fanout_count — see docs/GRAPH_SUPERVISOR_PLAN.md §9." }
      ]
    }
  ]
}
